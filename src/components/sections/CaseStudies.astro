---
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies'))
  .filter((study) => study.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .slice(0, 4);
---

<section id="work" class="py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-sm font-medium tracking-wider text-accent uppercase">Work</h2>
        <p class="mt-2 text-3xl font-bold tracking-tight text-text">
          Case Studies
        </p>
        <div class="mt-4 h-1 w-12 rounded-full bg-gradient-to-r from-[var(--gradient-start)] to-[var(--gradient-end)]"></div>
      </div>
      {caseStudies.length > 0 && (
        <a href="/case-studies" class="hidden text-sm font-medium text-accent hover:text-accent-hover sm:block transition-colors">
          View all case studies &rarr;
        </a>
      )}
    </div>

    {caseStudies.length > 0 ? (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {caseStudies.map((study) => (
          <a
            href={`/case-studies/${study.id.replace(/\.mdx?$/, '')}`}
            class="group rounded-xl border border-border bg-bg-surface p-6 transition-all hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5 hover:-translate-y-1"
          >
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-lg font-semibold text-text group-hover:text-accent transition-colors">
                  {study.data.title}
                </h3>
                <p class="mt-1 text-sm text-accent/80">{study.data.role}</p>
              </div>
              <svg class="h-5 w-5 text-text-secondary transition-transform group-hover:translate-x-1 group-hover:text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
              </svg>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary line-clamp-2">
              {study.data.tagline}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {study.data.technologies.slice(0, 4).map((tech) => (
                <span class="rounded-md bg-accent-muted px-2 py-0.5 text-xs text-accent border border-accent/10">
                  {tech}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-12 text-text-secondary">Case studies coming soon.</p>
    )}

    {caseStudies.length > 0 && (
      <div class="mt-8 text-center sm:hidden">
        <a href="/case-studies" class="text-sm font-medium text-accent hover:text-accent-hover transition-colors">
          View all case studies &rarr;
        </a>
      </div>
    )}
  </div>
</section>
