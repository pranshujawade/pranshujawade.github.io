---
import skillsData from '@/data/skills.json';
---

<section id="skills" class="py-24 sm:py-28 bg-bg-surface">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-sm font-medium tracking-wider text-accent uppercase">Skills</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-text">
        Tech Stack
      </p>
      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gradient-to-r from-[var(--gradient-start)] to-[var(--gradient-end)]"></div>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skillsData.categories.map((category) => (
        <div class="group rounded-xl border border-border bg-bg p-5 transition-all hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5">
          <h3 class="text-sm font-semibold text-text group-hover:text-accent transition-colors">{category.name}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {category.items.map((item) => (
              <span class="rounded-md bg-bg-surface px-2.5 py-1 text-xs text-text-secondary border border-border">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
