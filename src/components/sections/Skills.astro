---
import skillsData from '@/data/skills.json';
---

<section id="skills" class="py-20 sm:py-24 bg-bg-surface">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-sm font-medium tracking-wider text-accent uppercase">Skills</h2>
    <p class="mt-2 text-3xl font-bold tracking-tight text-text">
      Tech Stack
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {skillsData.categories.map((category) => (
        <div class="rounded-xl border border-border bg-bg p-6">
          <h3 class="text-lg font-semibold text-text">{category.name}</h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {category.items.map((skill) => (
              <span class="rounded-md bg-bg-surface px-3 py-1 text-sm text-text-secondary border border-border">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
