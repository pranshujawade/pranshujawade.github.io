---
import Layout from '@components/layout/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout
  title="Blog"
  description="Thoughts on software engineering, architecture, and building products that scale."
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">Blog</h1>
      <p class="mt-2 text-text-secondary">
        Thoughts on software engineering, architecture, and building products that scale.
      </p>

      {posts.length > 0 ? (
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id.replace(/\.mdx?$/, '')}`}
              class="group rounded-xl border border-border bg-bg-surface p-6 transition-all hover:border-accent/30 hover:shadow-lg hover:shadow-accent/5"
            >
              <time datetime={post.data.pubDate.toISOString()} class="text-xs text-text-secondary">
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="mt-2 text-lg font-semibold text-text group-hover:text-accent transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-text-secondary line-clamp-3">
                {post.data.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded-md bg-bg px-2 py-0.5 text-xs text-text-secondary border border-border">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-text-secondary">No posts yet. Check back soon.</p>
      )}
    </div>
  </section>
</Layout>
